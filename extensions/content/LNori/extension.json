  "capabilities": [
    "browse",
    "discover",
    "search",
    "details",
    "installments",
    "acquisition",
    "cookies",
    "challengeHandoff",
    "filters"
  ],
  "permissions": [
    "network",
    "cookies",
    "rateLimiting",
    "redactedLogging",
    "challengeHandoff",
    "state"
