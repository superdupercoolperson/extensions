{
  "id": "LNori",
  "name": "LNORI",
  "description": "English light-novel discovery, series details, and XHTML volume reading from lnori.com.",
  "kind": "content",
  "apiVersion": "3.0",
  "runtime": "wasm",
  "crate": "manko-lnori",
  "version": "3.0.1",
  "language": "en",
