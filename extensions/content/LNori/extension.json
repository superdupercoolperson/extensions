    "cdn.lnori.com",
    "img.lnori.com"
  ],
  "authenticationModes": [
    "none"
  ],
  "developers": [
    {
      "name": "superdupercoolperson",
      "github": "https://github.com/superdupercoolperson"
    }
  ],
  "iconFile": "icon.svg",
  "license": "Apache-2.0",
  "compatibility": {
    "adapter": "native-rust-wasm",
    "status": "supported",
    "scope": "core",
    "note": null,
    "limitations": [
      "Volume text is supported. Manko currently removes external illustrations when generating EPUBs."
    ],
    "runtime": "native-wasm",
    "apiVersion": "3.0"
  },
  "homepage": "https://lnori.com"
}
